rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin-ness is checked directly against the Firebase Auth token, not
    // against any client-writable data. request.auth.token.email is only
    // ever populated after a real Firebase email/password sign-in, and
    // request.auth.token.phone_number is only ever populated after a real,
    // freshly-verified SMS OTP confirmation - neither can be forged by
    // typing a value into a form. Keep this in sync with the two admin
    // identities configured in the app (see src/components/AuthModal.tsx).
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@recell.in' ||
        request.auth.token.phone_number == '+919310552055'
      );
    }

    // --- Product catalog (system/catalog doc) ---
    // Public read for the storefront, admin-only write.
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User profiles ---
    // Doc IDs are the user's phone/email string (matching the app's
    // existing key scheme), not the Firebase Auth uid, so ownership can't
    // be checked via userId == request.auth.uid here. Any signed-in user
    // may read/create/update a profile document; the protection that
    // actually matters is the role lock below, which no client write can
    // ever bypass regardless of which document it targets.
    match /users/{userId} {
      // A single-doc read (get) stays open to any signed-in user - the app
      // relies on this to look up someone's own profile by phone/email key
      // during login. A collection-wide read (list) is admin-only, so the
      // Admin Dashboard's Customers tab can see every registered account
      // without opening that up to every signed-in customer too.
      allow get: if isSignedIn();
      allow list: if isAdmin();
      // A brand-new profile may only ever be created with role 'customer'.
      // Admin status is never client-settable, at signup or afterwards.
      allow create: if isSignedIn() && request.resource.data.role == 'customer';
      // Anyone signed in may update non-role fields; only an admin may
      // change a role field (and only via the Firebase console / Admin SDK
      // in practice, since no client code path ever sends role).
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // --- Orders ---
    // Public read is intentional: the storefront's "Track My Order" flow
    // looks orders up by phone number without requiring login. Writes are
    // tightly scoped: a new order may only be created in a non-paid state;
    // paymentStatus can only ever flip to 'Paid' via the Cloud Function
    // (Admin SDK, which bypasses these rules), never by a client update.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.paymentStatus != 'Paid';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Sell / buyback requests ---
    match /sell_requests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Repair bookings ---
    match /repair_bookings/{bookingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Return requests (7-Day Return Policy) ---
    match /returns/{returnId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Warranty claims (3-Month ReCell Warranty) ---
    match /warranty_claims/{claimId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Live "active visitors" presence heartbeat ---
    // Every visitor (including anonymous, not-signed-in browsing) needs to
    // write their own heartbeat doc, so this stays open rather than
    // requiring Firebase Anonymous Auth to be enabled as a separate manual
    // Console step. Docs carry only a sessionId (random, not tied to any
    // identity) and a server timestamp - no personal data - so the
    // exposure from an open write is minimal. Only admins can read the
    // collection back to compute a live count.
    match /presence/{sessionId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // --- Payment records ---
    // Never client-writable. Only the verifyRazorpayPayment Cloud Function
    // (Admin SDK) writes here, after checking a real Razorpay signature.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
