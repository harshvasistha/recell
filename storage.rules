rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors firestore.rules' isAdmin() check exactly: admin-ness is
    // verified against the real Firebase Auth token (email or the
    // OTP-verified phone number), never against anything client-writable.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@recell.in' ||
        request.auth.token.phone_number == '+919310552055'
      );
    }

    // Catalog product photos - self-hosted here instead of hotlinked from
    // Google Drive (see src/lib/storage.ts for why). Public read so the
    // storefront can display them to anyone; only the admin account may
    // upload or replace one.
    match /product-images/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
