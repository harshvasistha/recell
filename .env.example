# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://recell.co.in).
APP_URL="MY_APP_URL"

# Razorpay keys are no longer read from the frontend build at all - the
# createRazorpayOrder Cloud Function returns the publishable key id at
# checkout time, straight from the trusted secret store. Nothing Razorpay-
# related needs to be set in AWS Amplify's build environment variables.
#
# RAZORPAY_KEY_SECRET must NEVER be here, in any .env file, or anywhere in
# the client bundle - it is a private secret. It lives ONLY in the Cloud
# Functions secret store, set via:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_KEY_ID
# (A live test/secret pair was previously committed to this file's git
# history and must be treated as compromised - rotate it in the Razorpay
# dashboard before going live.)
