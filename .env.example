# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://recell.co.in).
APP_URL="MY_APP_URL"

# PayU credentials belong only in Firebase Cloud Functions secrets:
# firebase functions:secrets:set PAYU_MERCHANT_KEY --project recell-new
# firebase functions:secrets:set PAYU_MERCHANT_SALT --project recell-new
# Do not add the merchant salt to Amplify or any frontend environment variable.
